# Server (Node / Vercel)
# Port the Node server listens on.
PORT=8787
# Path to the SQLite database file (Node only).
SURKET_DB=./server/surket.db
# Set a strong secret to require admin auth on mutating API routes.
# Leave empty for open "dev" mode.
ADMIN_TOKEN=
# Set to 0 to skip seeding demo data on first boot.
SURKET_SEED=1

# Web (build-time)
# Base URL for the API. Leave empty to use a same-origin /api.
VITE_API_BASE=
