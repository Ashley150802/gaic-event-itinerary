{
  "name": "@surket/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "node --watch --experimental-sqlite --import tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --experimental-sqlite dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "deploy:cf": "wrangler deploy",
    "d1:init": "wrangler d1 execute surket --file=./migrations/0001_init.sql",
    "d1:init:local": "wrangler d1 execute surket --local --file=./migrations/0001_init.sql"
  },
  "dependencies": {
    "@hono/node-server": "latest",
    "hono": "latest",
    "ws": "latest"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@types/node": "latest",
    "@types/ws": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "wrangler": "latest"
  }
}
